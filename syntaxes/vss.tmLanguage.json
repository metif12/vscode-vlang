{
	"name": "VSS",
	"scopeName": "source.vss",
	"$comment": "hex colors win in value position (the hex matcher rejects selector headers, i.e. text running to an opening brace with no declaration in between); IDs therefore need no hex guard and match hex-shaped selectors such as #abc; at-rules cover supports plus a generic block fallback (line-start or inline before a block); -- custom properties are variables; transition-*/animation-* are supported via the animation driver.",
	"fileTypes": [".vss"],
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#at-rules" },
		{ "include": "#variables" },
		{ "include": "#values" },
		{ "include": "#selectors" },
		{ "include": "#properties" }
	],
	"repository": {
		"comments": {
			"patterns": [{ "name": "comment.block.vss", "begin": "/\\*", "end": "\\*/" }]
		},
		"at-rules": {
			"patterns": [
				{
					"name": "keyword.control.at-rule.vss",
					"match": "@(import|keyframes|media|container|supports)\\b"
				},
				{
					"name": "keyword.control.at-rule.vss",
					"match": "(?:^\\s*|(?=[^;{}]*\\{))@[a-zA-Z_][a-zA-Z0-9_-]*\\b(?![\\w-]*\\s*:)"
				},
				{ "name": "keyword.control.at-rule.vss", "match": "\\b(light|dark)\\s*\\{" }
			]
		},
		"variables": {
			"patterns": [
				{ "name": "variable.other.vss", "match": "@[a-zA-Z_][a-zA-Z0-9_-]*" },
				{ "name": "variable.other.vss", "match": "--[a-zA-Z_][a-zA-Z0-9_-]*" }
			]
		},
		"selectors": {
			"patterns": [
				{
					"name": "entity.name.tag.vss",
					"match": "(?i)\\b(screen|view|label|image|button|checkbox|dropdown|text_field|text_area|scroll|slider|switch_control|toggle_button|opengl)\\b"
				},
				{
					"name": "entity.other.attribute-name.class.vss",
					"match": "\\.[a-zA-Z_][a-zA-Z0-9_-]*"
				},
				{
					"name": "entity.other.attribute-name.id.vss",
					"match": "#[a-zA-Z_][a-zA-Z0-9_-]*"
				},
				{ "name": "entity.other.attribute-name.pseudo-class.vss", "match": ":[a-zA-Z_-]+" },
				{ "name": "entity.other.attribute-name.universal.vss", "match": "\\*" }
			]
		},
		"properties": {
			"patterns": [
				{
					"name": "support.type.property-name.vss",
					"match": "(?i)\\b(background-color|background-gradient|background|color|font-size|font-family|font-weight|font-style|text-align|text-decoration|border-radius|border-color|border-width|border|opacity|box-shadow|padding|margin|gap|transition-property|transition-duration|transition-timing-function|transition-delay|transition|animation-name|animation-duration|animation-timing-function|animation-delay|animation-iteration-count|animation-direction|animation-fill-mode|animation-play-state|animation)\\b(?=\\s*:)"
				}
			]
		},
		"values": {
			"patterns": [
				{
					"name": "constant.numeric.color.hex.vss",
					"match": "#[0-9a-fA-F]{3,8}\\b(?!(?:(?!:\\s)[^;{}])*\\{)"
				},
				{ "name": "constant.numeric.vss", "match": "\\b\\d+(\\.\\d+)?(px|ms|s|%)?(?!\\w)" },
				{ "name": "string.quoted.double.vss", "begin": "\"", "end": "\"" }
			]
		}
	}
}
